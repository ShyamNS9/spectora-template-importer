{
  "name": "spectora-template-importer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --env-file-if-exists=.env.local --test lib/spectora/*.test.ts lib/db/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "inspect-export": "tsx scripts/inspect-export.ts",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "verify": "tsx --env-file=.env.local scripts/verify-import.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
