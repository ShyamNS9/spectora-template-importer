# Copy to .env.local and fill in. .env* is gitignored; no credentials belong
# in this repository.
#
# Supabase: Connect -> Transaction pooler (port 6543).
#
# Use the pooler rather than the direct connection. db.<ref>.supabase.co
# resolves to IPv6 only, which Vercel cannot reach, and transaction mode pools
# per transaction rather than per client, which is what serverless needs.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
